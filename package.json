{
  "name": "web",
  "version": "0.0.0",
  "description": "A RAG Application built with React and TypeScript",
  "private": true,
  "type": "module",
  "author": {
    "name": "Embroidery Team",
    "slack": "#mcp-support-artwork-processing",
    "email": "EmbroiderySupport@cimpress.com"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@cimpress-ui/react": "^1.34.3",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.1"
  }
}
